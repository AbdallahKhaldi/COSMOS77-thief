# Copy to .env (gitignored) and fill. Only the Gemini key is needed to run live;
# every test mocks it, so an absent key just means template hints.
GEMINI_API_KEY=

# Public MCP endpoint this process is reachable at (greeting/declaration identity).
# Set by the hub (or a tunnel operator) per process; unset = the loopback default,
# which is only truthful for local runs.
COSMOS_PUBLIC_MCP_URL=
